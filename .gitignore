# OS and editors
.DS_Store
*.swp
.idea/
*.iml
.vscode/
.fleet/

# Gradle / Kotlin
.gradle/
.kotlin/
build/
local.properties
captures/
# Ad-hoc image dumps from local tooling; icon artwork belongs in assets/branding (LB-413).
generated_images/
*.hprof

# Android
*.apk
*.aab
*.keystore
*.jks
.externalNativeBuild/
.cxx/

# Xcode / iOS
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint
iosApp/Pods/
# Generated by scripts/ios/generate-project.sh (LB-001); never committed
iosApp/iosApp.xcodeproj/
iosApp/Configuration/Version.xcconfig
*.xcframework
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Secrets and local config
*.env
secrets.properties

# Claude Code personal overrides
.claude/settings.local.json

# The Swift packages' own pins: iosApp/Package.resolved is the only one (docs/ci_cd.md §6), and Xcode writes these
# when it resolves a package on its own.
iosApp/Packages/*/Package.resolved

# scripts/record-fixtures.sh stages a capture in a temporary directory beside fixtures/ and moves it into place when the
# whole run succeeded. A run killed outright leaves the directory behind; it is never part of a change (LB-003).
.record-fixtures.*/
