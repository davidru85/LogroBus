#!/usr/bin/env bash
# Git commit-msg hook: enforces Conventional Commit subjects, and rejects
# Co-Authored-By trailers (AGENTS.md §12).
# Installed by scripts/bootstrap.sh (core.hooksPath=.githooks).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
"$root/scripts/checks/check-commit-identity.sh" --message "$1"
subject="$(head -n 1 "$1")"

case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

"$root/scripts/checks/check-conventional-title.sh" "$subject"
