import kotlin.Boolean;

-- Spec §8.8: the line catalogue (API-01).
CREATE TABLE line (
  id INTEGER PRIMARY KEY,
  code TEXT NOT NULL,
  raw_name TEXT NOT NULL,
  display_name TEXT NOT NULL,
  color INTEGER NOT NULL,
  on_color INTEGER NOT NULL,
  kind TEXT NOT NULL,
  operational INTEGER AS Boolean NOT NULL
);

CREATE TABLE pattern (
  line_id INTEGER NOT NULL,
  direction TEXT NOT NULL,
  headsign TEXT NOT NULL,
  -- An encoded polyline, precision 6.
  shape_polyline TEXT NOT NULL,
  PRIMARY KEY (line_id, direction)
);

CREATE TABLE pattern_stop (
  line_id INTEGER NOT NULL,
  direction TEXT NOT NULL,
  seq INTEGER NOT NULL,
  stop_id INTEGER NOT NULL,
  shape_index INTEGER NOT NULL,
  PRIMARY KEY (line_id, direction, seq)
);

-- The patterns that serve a stop, for its headsigns in search results (DD-16) and direction inference (DD-04).
CREATE INDEX pattern_stop_by_stop ON pattern_stop (stop_id);

-- LB-008: the static sync replaces the catalogue in one transaction (architecture.md §4.4).
deleteLines:
DELETE FROM line;

deletePatterns:
DELETE FROM pattern;

deletePatternStops:
DELETE FROM pattern_stop;

insertLine:
INSERT INTO line (id, code, raw_name, display_name, color, on_color, kind, operational)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertPattern:
INSERT INTO pattern (line_id, direction, headsign, shape_polyline) VALUES (?, ?, ?, ?);

insertPatternStop:
INSERT INTO pattern_stop (line_id, direction, seq, stop_id, shape_index) VALUES (?, ?, ?, ?, ?);

-- LB-101: the Lines list, which groups and sorts them itself (FR-LINE-01). LB-103: one row per pattern, for each
-- direction's headsign (FR-LINE-13), or one with no direction for a line with no patterns.
selectLines:
SELECT line.id, code, display_name, color, on_color, kind, operational, pattern.direction, pattern.headsign
FROM line LEFT JOIN pattern ON pattern.line_id = line.id
ORDER BY line.id;

-- LB-102 part 2: the names of the stops a line's patterns pass, folded as the stop search folds them, for the search
-- to match a line by a stop it serves (FR-LINE-03). One row per line and name, so a name two directions share counts
-- once. The join runs on pattern_stop's index by stop, and the name comes from the stop catalogue.
selectLineStopNames:
SELECT DISTINCT ps.line_id, s.normalized_name
FROM pattern_stop ps
JOIN stop s ON s.id = ps.stop_id
ORDER BY ps.line_id, s.normalized_name;

-- LB-104: a line's patterns with their stops in sequence order, for the ordered stop list of its detail. The join
-- brings each stop's name and position; `seq` orders them, and `shape_index` places each on the shape (LB-013).
selectPatternStops:
SELECT ps.line_id, ps.direction, ps.seq, ps.stop_id, ps.shape_index, s.name, s.lat, s.lng
FROM pattern_stop ps
JOIN stop s ON s.id = ps.stop_id
ORDER BY ps.line_id, ps.direction, ps.seq;

-- LB-105 (DD-04): the stop ids of one line's patterns in sequence order, which is what places its calls. ET's
-- `directionRef` is an opaque code, so a call's direction is inferred from where it is in the journey.
selectLinePatternStopIds:
SELECT direction, stop_id
FROM pattern_stop
WHERE line_id = ?
ORDER BY direction, seq;
