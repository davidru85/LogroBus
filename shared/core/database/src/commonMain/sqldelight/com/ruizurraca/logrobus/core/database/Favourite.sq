-- Spec §8.8: what the user saves on the device.
CREATE TABLE favourite (
  id TEXT PRIMARY KEY,
  type TEXT NOT NULL,
  ref_id TEXT NOT NULL,
  label TEXT,
  position INTEGER NOT NULL,
  created_at INTEGER NOT NULL,
  -- architecture.md §4.3, FR-FAV-04: consecutive syncs in which a favourite stop was missing.
  missing_syncs INTEGER NOT NULL DEFAULT 0,
  -- One favourite per line or stop, so a double tap cannot save it twice (FR-FAV-05 counts them).
  UNIQUE (type, ref_id)
);

CREATE TABLE place (
  id TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  lat REAL NOT NULL,
  lng REAL NOT NULL
);

-- architecture.md §4.3, FR-PLAN-09: the last 10 planner searches.
CREATE TABLE plan_recent (
  id TEXT PRIMARY KEY,
  origin TEXT,
  destination TEXT,
  created_at INTEGER NOT NULL
);
