import kotlin.time.Instant;

-- Spec §8.8: what the user saves on the device.
CREATE TABLE favourite (
  id TEXT PRIMARY KEY,
  type TEXT NOT NULL,
  ref_id TEXT NOT NULL,
  label TEXT,
  position INTEGER NOT NULL,
  created_at INTEGER AS Instant NOT NULL,
  -- architecture.md §4.3, FR-FAV-04: consecutive syncs in which a favourite stop was missing.
  missing_syncs INTEGER NOT NULL DEFAULT 0,
  -- One favourite per line or stop, so a double tap cannot save it twice (FR-FAV-05 counts them).
  UNIQUE (type, ref_id)
);

CREATE TABLE place (
  id TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  lat REAL NOT NULL,
  lng REAL NOT NULL
);

-- architecture.md §4.3, FR-PLAN-09: the last 10 planner searches.
CREATE TABLE plan_recent (
  id TEXT PRIMARY KEY,
  origin TEXT,
  destination TEXT,
  created_at INTEGER AS Instant NOT NULL
);

-- FR-FAV-04: after each successful static sync, a saved stop that is no longer in the catalogue has one more missing
-- sync, and one that is back starts from zero. A provisional stop made up from a pattern (DD-10) is still served, so it
-- counts as there.
updateMissingSyncs:
UPDATE favourite
SET missing_syncs = CASE
  WHEN ref_id IN (SELECT CAST(id AS TEXT) FROM stop) THEN 0
  ELSE missing_syncs + 1
END
WHERE type = :stopType;
