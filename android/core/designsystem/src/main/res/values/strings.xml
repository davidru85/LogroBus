<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The spoken label of a line badge: the line, never its colour (design_guidelines.md §6.2, key line.badge). -->
    <string name="line_badge">Línea %1$s</string>

    <!-- ETAs (spec §5.7, design_guidelines.md §6.3, keys eta.*): what shows, then what TalkBack says. -->
    <string name="eta_now">Ahora</string>
    <string name="eta_minutes">%1$d min</string>
    <string name="eta_approximate">~%1$s</string>
    <string name="eta_scheduled">Programado</string>
    <string name="eta_cancelled">Cancelado</string>
    <string name="eta_late">+%1$d min tarde</string>
    <string name="eta_early">%1$d min antes</string>
    <string name="eta_now_spoken">llega ahora</string>
    <plurals name="eta_minutes_spoken">
        <item quantity="one">en %1$d minuto</item>
        <item quantity="other">en %1$d minutos</item>
    </plurals>
    <!-- "A la una", in the singular, for the hour 1; "a las" otherwise. The quantity is the hour. -->
    <plurals name="eta_clock_spoken">
        <item quantity="one">a la %1$s</item>
        <item quantity="other">a las %1$s</item>
    </plurals>
    <plurals name="eta_scheduled_spoken">
        <item quantity="one">programado a la %1$s</item>
        <item quantity="other">programado a las %1$s</item>
    </plurals>
    <string name="eta_scheduled_short_spoken">programado</string>
    <string name="eta_now_approximately_spoken">llega ahora, aproximadamente</string>
    <string name="eta_approximately_spoken">aproximadamente %1$s</string>
    <plurals name="eta_late_spoken">
        <item quantity="one">%1$d minuto tarde</item>
        <item quantity="other">%1$d minutos tarde</item>
    </plurals>
    <plurals name="eta_early_spoken">
        <item quantity="one">%1$d minuto antes</item>
        <item quantity="other">%1$d minutos antes</item>
    </plurals>
    <string name="eta_cancelled_spoken">cancelado</string>
    <!-- The time, then what the secondary line says: "en 4 minutos, 3 minutos tarde". -->
    <string name="eta_spoken_join">%1$s, %2$s</string>

    <!-- Top app bar actions (LB-012, design_guidelines.md §9, keys action.*): what TalkBack says for each icon. -->
    <string name="action_more">Más</string>
    <string name="action_navigate_up">Atrás</string>
</resources>
