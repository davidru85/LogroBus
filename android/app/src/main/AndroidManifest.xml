<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FR-LOC-01: foreground location, asked for just in time on Near Me (LB-201). Coarse and fine together, so that
         the user may grant approximate location only. Never background location (security_privacy.md §3). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- The app's languages, which Android 13+ offers in
         its per-app language setting (ADR-0020). The backups keep the user's own data only (FR-FAV-03): the rules
         from Android 12, the full backup content before it. -->
    <application
        android:name=".LogroBusApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LogroBus">

        <!-- adjustResize: edge to edge, the window never resizes for the keyboard, but reports it as insets, which
             the Lines list pads by (LB-102). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Below Android 13, AppCompat keeps the language chosen in Settings itself (ADR-0020). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
