<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The stop detail (SC-05, LB-205, design_guidelines.md §3.2). Spanish (es-ES) is the default language. -->
    <!-- The detail's title while it loads, before the stop's name is known. -->
    <string name="stop_detail_title_generic">Parada</string>
    <!-- Spec §7.3 and design_guidelines.md §8: what TalkBack says while the first load runs. -->
    <string name="stop_detail_loading">Cargando parada</string>
    <!-- FR-STOP-03 and DD-16: the headsign of the pattern that reaches the stop. -->
    <string name="stop_detail_towards">Hacia %1$s</string>
    <!-- How TalkBack reads one served line: the badge's own label ("Línea 1") and its headsign. -->
    <string name="stop_detail_served_line_spoken">%1$s, %2$s</string>
    <!-- FR-STOP-05 and design_guidelines.md §9 (key freshness.updated_ago): how old the arrivals are. -->
    <string name="stop_detail_updated_ago">Actualizado hace %1$d s</string>
    <!-- Spec §5.7: past 120 s the ETAs are clock times, and this action fetches the list again. -->
    <string name="stop_detail_tap_to_refresh">Toca para actualizar</string>
    <!-- LB-205 (spec §5.7): a row's one utterance, "Línea 1, Hacia Hospital San Pedro, en 4 minutos", and the dash of a
         row the mapper could not place. The ETA itself is the design system's (keys eta.*). -->
    <string name="stop_detail_arrival_spoken">%1$s, %2$s</string>
    <string name="stop_detail_arrival_headsign_spoken">%1$s, %2$s, %3$s</string>
    <string name="stop_detail_eta_none">–</string>
    <string name="stop_detail_eta_none_spoken">sin avisos</string>
    <!-- LB-208 (FR-STOP-08): saving a stop. The label says what a tap does, and the unsaved one is a button, not a
         checkbox, as the favourite lines' star is. -->
    <string name="stop_detail_save">Guardar parada</string>
    <string name="stop_detail_unsave">Quitar la parada guardada: %1$s</string>
    <string name="stop_detail_save_title">Guardar parada</string>
    <string name="stop_detail_save_alias">Nombre (opcional, %1$d caracteres)</string>
    <string name="stop_detail_save_confirm">Guardar</string>
    <string name="stop_detail_save_cancel">Cancelar</string>
    <!-- LB-206 (FR-STOP-06): what an empty arrival list says. The night sentence itself comes from remote config
         (OQ-08), so it is not a string here. -->
    <string name="stop_detail_no_buses">No hay autobuses en los próximos 60 minutos</string>
    <string name="stop_detail_no_buses_night">No hay autobuses en los próximos 60 minutos. %1$s</string>
</resources>
