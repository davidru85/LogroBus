<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Lines list (LB-101, design_guidelines.md §3.1 and §9, keys tab.lines and lines.*). Spanish (es-ES) is the default language. -->
    <string name="lines_title">Líneas</string>
    <string name="lines_group_day">Líneas diurnas</string>
    <string name="lines_group_night">Líneas nocturnas (Búho)</string>
    <!-- FR-LINE-02: the status chip of a line that is not operational. -->
    <string name="lines_not_operational">Sin servicio</string>
    <!-- Spec §7.3 and design_guidelines.md §8: what TalkBack says while the first load runs. -->
    <string name="lines_loading">Cargando líneas</string>
    <!-- Spec §7.3: the Empty state, one sentence and Retry. -->
    <string name="lines_empty">No hay líneas que mostrar.</string>
    <!-- LB-102 (FR-LINE-03): the search field over the list, and the sentence of a search that found nothing. -->
    <string name="lines_search">Buscar línea</string>
    <string name="lines_no_matches">Ninguna línea coincide con tu búsqueda.</string>
    <!-- LB-103: the favourite lines carousel (FR-LINE-12 to 14) and the toggle of each row and line detail (FR-LINE-15). -->
    <string name="lines_favourites_title">Tus líneas favoritas</string>
    <string name="lines_favourites_hint">Marca ☆ en una línea para tenerla aquí</string>
    <!-- How TalkBack reads the hint: words, never the star symbol. -->
    <string name="lines_favourites_hint_spoken">Marca la estrella de una línea para tenerla aquí</string>
    <!-- What a double tap on a row or a card does, as TalkBack says it. -->
    <string name="lines_open_line">abrir línea</string>
    <string name="lines_favourite_add">Añadir línea %1$s a favoritas</string>
    <string name="lines_favourite_remove">Quitar línea %1$s de favoritas</string>
    <!-- How TalkBack reads each headsign of a favourite card, which shows "→ Hospital San Pedro". -->
    <string name="lines_towards">Hacia %1$s</string>
    <!-- LB-110: the favourite lines' edit sheet (FR-FAV-02). The carousel's button shows "Editar", and TalkBack reads the
         sheet's title as its name, which keeps the word it shows. -->
    <string name="lines_favourites_edit">Editar</string>
    <string name="lines_favourites_edit_title">Editar líneas favoritas</string>
    <string name="lines_favourites_done">Listo</string>
    <!-- A favourite whose line has left the catalogue: the app no longer knows its code or name. -->
    <string name="lines_favourites_no_longer_served">Línea que ya no circula</string>
    <string name="lines_favourites_remove_no_longer_served">Quitar de favoritas la línea que ya no circula</string>
    <!-- TalkBack's actions on a row, which reorder without dragging (NFR-A11Y). -->
    <string name="lines_favourites_move_up">Subir</string>
    <string name="lines_favourites_move_down">Bajar</string>
    <!-- A row's place in the edit sheet, which TalkBack says as the row's state, so each move is heard. -->
    <string name="lines_favourites_position">%1$d de %2$d</string>
    <!-- FR-FAV-05: a star tapped with the most favourite lines saved. -->
    <plurals name="lines_favourites_limit">
        <item quantity="one">Ya tienes %1$d línea favorita, el máximo. Quita alguna para añadir otra.</item>
        <item quantity="many">Ya tienes %1$d líneas favoritas, el máximo. Quita alguna para añadir otra.</item>
        <item quantity="other">Ya tienes %1$d líneas favoritas, el máximo. Quita alguna para añadir otra.</item>
    </plurals>
    <!-- The line detail (SC-04), until LB-104 adds its map, directions and stops. -->
    <string name="line_detail_title">Línea %1$s</string>
    <!-- The detail's title while it loads or fails, before the line's code is known. -->
    <string name="line_detail_title_generic">Línea</string>
    <string name="line_detail_loading">Cargando línea</string>
    <!-- LB-104: the line detail's direction toggle and its ordered stop list. -->
    <string name="line_detail_direction">Sentido</string>
    <string name="line_detail_stop_position">Parada %1$d, %2$s</string>
</resources>
