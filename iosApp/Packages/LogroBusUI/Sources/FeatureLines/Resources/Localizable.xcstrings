      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no lines to show."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay líneas que mostrar."
          }
        }
      }
    },
