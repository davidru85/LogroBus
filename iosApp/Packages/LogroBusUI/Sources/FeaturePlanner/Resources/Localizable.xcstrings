{
  "sourceLanguage": "es",
  "strings": {
    "plan.depart_at_choose": {
      "comment": "How to Get There: the departure menu's item that opens the date and time picker (FR-PLAN-03, LB-303).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depart at…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir a las…"
          }
        }
      }
    },
    "plan.depart_on %lld %@ %@": {
      "comment": "How to Get There: a departure time on another day (LB-303). The first argument is the hour, which picks Spanish's article; the second the day and month, as \"15 ene\"; the third the time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depart on %2$@ %#@article@ %3$@"
          },
          "substitutions": {
            "article": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "at"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "at"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir el %2$@ %#@article@ %3$@"
          },
          "substitutions": {
            "article": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "a la"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "a las"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
