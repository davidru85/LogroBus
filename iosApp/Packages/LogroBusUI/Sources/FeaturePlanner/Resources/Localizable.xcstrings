    "plan.departure_cancel": {
      "comment": "How to Get There: closes the date and time picker without changing the departure (LB-303).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "plan.departure_done": {
      "comment": "How to Get There: confirms the picked date and time as the departure (LB-303).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar"
          }
        }
      }
    },
    "plan.departure_time": {
      "comment": "How to Get There: the date and time picker's title and the picker's spoken name (FR-PLAN-03, LB-303).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Departure time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de salida"
          }
        }
      }
    },
    "plan.destination": {
      "comment": "How to Get There: the destination field's spoken name, before what it shows (NFR-A11Y-02, LB-301).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino"
          }
        }
      }
    },
    "plan.destination.hint": {
      "comment": "How to Get There: the empty destination field's hint (design_guidelines.md §3.3).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where to?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A dónde vas?"
          }
        }
      }
    },
    "plan.leave_now": {
      "comment": "How to Get There: the departure row and its menu's first item, leaving when the plan is requested (FR-PLAN-03, LB-303).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir ahora"
          }
        }
      }
    },
    "plan.my_location": {
      "comment": "How to Get There: the user's location, in either field; the origin's with the location permission (FR-PLAN-11, FR-PLAN-08).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My location"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi ubicación"
          }
        }
      }
    },
    "plan.origin": {
      "comment": "How to Get There: the origin field's spoken name, before what it shows (NFR-A11Y-02, LB-301).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Origen"
          }
        }
      }
    },
    "plan.origin.hint": {
      "comment": "How to Get There: the empty origin field's hint, without the location permission (FR-PLAN-11).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where from?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desde dónde?"
          }
        }
      }
    },
    "plan.swap": {
      "comment": "How to Get There: the swap button between the fields, spoken only: it shows an icon (FR-PLAN-08, LB-304).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap origin and destination"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercambiar origen y destino"
          }
        }
      }
    },
    "plan.title": {
      "comment": "How to Get There: the root's title; its tab says tab.directions (design_guidelines.md §2.1 and §9).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to get there"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo llegar"
          }
        }
      }
    }
